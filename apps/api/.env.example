# Copy this file to .env and adjust as needed.

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Postgres connection used by the running API and by node-pg-migrate.
# The docker-compose Postgres service is published on host port 55432
# (container-internal port stays 5432) to avoid clashing with any other
# local Postgres instance.
DATABASE_URL=postgresql://fulfillment:fulfillment@localhost:55432/fulfillment_ops

# Separate database used only by the integration test suite so tests never
# touch development data.
TEST_DATABASE_URL=postgresql://fulfillment:fulfillment@localhost:55432/fulfillment_ops_test

# CORS origin allowed to call the API (the Vite dev server by default).
WEB_ORIGIN=http://localhost:5173
